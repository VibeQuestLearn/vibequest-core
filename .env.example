APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://share-ai.ckbdev.com
OPENAI_REASONING_EFFORT=xhigh
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_TIMEOUT_SECONDS=180

# Runtime integrations required for /ready and reward claiming.
CKB_RPC_URL=https://testnet.ckbapp.dev/
FIBER_RPC_URL=http://18.163.221.211:8227

# MongoDB persistence for users, quest runs, progress, and shipping state.
MONGODB_URI=
MONGODB_DATABASE=vibequest
# Fresh v3 namespace for ecosystem-neutral learner records.
MONGODB_DATABASE_V3=vibequestlearn_v3

# Fiber payout rail. Use a private funded Fiber node RPC, never a public/read-only RPC.
FIBER_PAYOUT_ENABLED=false
FIBER_PAYOUT_RPC_URL=
VIBEQUEST_REWARD_SHANNONS=400
VIBEQUEST_REWARD_CURRENCY=Fibd
